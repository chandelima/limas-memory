OPENROUTER_API_KEY=sua-chave-aqui
# OPENROUTER_MODEL=openai/gpt-6-luna

# Pasta da memória (padrão: ./memory)
# MEMORY_DIR=

# Repositório git da memória (privado) e credenciais do push
# MEMORY_GIT_REMOTE=https://github.com/usuario/repo-privado.git
# MEMORY_GIT_USER_NAME=Memory Curator
# MEMORY_GIT_USER_EMAIL=curator@exemplo.com
# Token (PAT) do GitHub com acesso de escrita só a esse repo; use remote HTTPS
# MEMORY_GIT_TOKEN=

# Histórico da conversa (padrão: ./data/conversa.json) e inatividade, em segundos,
# antes de o Curator processar as mensagens novas (padrão: 600 = 10 min)
# CONVERSATION_FILE=
# CURATOR_IDLE_SECONDS=600

# Bot do Telegram. Token: crie o bot no @BotFather. Nunca compartilhe o token.
# TELEGRAM_BOT_TOKEN=
# ID numérico do seu usuário. Sem ele, o bot recusa todos e imprime o ID de quem escreveu.
# TELEGRAM_ALLOWED_USER_ID=

# Anexos: modelo que lê PDF e imagem (vazio = OPENROUTER_MODEL; precisa aceitar imagem
# para fotos) e motor de PDF do OpenRouter (vazio = automático; cloudflare-ai é grátis,
# mistral-ocr lê PDF escaneado). O registro dos arquivos fica em memory/anexos/*.md.
# DOCUMENT_MODEL=
# PDF_ENGINE=

# Resumo da manhã no Telegram: horário e, opcionalmente, o fuso (padrão: 06:00 no fuso da máquina).
# Exemplos: 06:00 | 06:00-03 | 06:00-03:00 | 06:00 America/Recife | 06:00Z | off (desliga)
# O deslocamento (-03) é fixo; use o nome do fuso se o seu lugar tem horário de verão.
# BRIEFING_TIME=06:00-03

# Logs. LOG_LEVEL: nível do console (DEBUG, INFO, WARNING, ERROR; padrão INFO).
# LOG_CHANNEL_ID: canal do Telegram que recebe os avisos do bot (vazio = desligado). Crie um
# canal, adicione o bot como ADMINISTRADOR com permissão de postar e informe o ID (-100...) ou
# @nomedocanal. LOG_CHANNEL_LEVEL: nível mínimo enviado ao canal (padrão WARNING; o início e a
# parada do bot sempre vão). Nenhum log leva o texto das suas mensagens nem da memória.
# LOG_LEVEL=INFO
# LOG_CHANNEL_ID=
# LOG_CHANNEL_LEVEL=WARNING

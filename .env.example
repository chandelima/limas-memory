OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=openai/gpt-6-luna

# Memory folder (default: ./memory)
# MEMORY_DIR=

# Git repository of the memory (private) and push credentials
# MEMORY_GIT_REMOTE=https://github.com/user/private-repo.git
# MEMORY_GIT_USER_NAME=Memory Curator
# MEMORY_GIT_USER_EMAIL=curator@example.com
# Token (PAT) with write access to that repo only; use an HTTPS remote
# MEMORY_GIT_TOKEN=

# Conversation history (default: ./data/conversation.json) and the inactivity, in seconds,
# before the Curator processes the new messages (default: 600 = 10 min)
# CONVERSATION_FILE=
# CURATOR_IDLE_SECONDS=600

# Telegram bot. Token: create the bot with @BotFather. Never share the token.
# TELEGRAM_BOT_TOKEN=
# Your numeric user ID. Without it, the bot refuses everyone and prints the ID of whoever wrote.
# TELEGRAM_ALLOWED_USER_ID=

# Attachments: model that reads PDFs and images (empty = OPENROUTER_MODEL; it must accept images
# for photos) and OpenRouter PDF engine (empty = automatic; cloudflare-ai is free,
# mistral-ocr reads scanned PDFs). The file registry lives in memory/attachments/*.md.
# DOCUMENT_MODEL=
# PDF_ENGINE=

# Morning briefing on Telegram: time and, optionally, the time zone (default: 06:00 in the machine's zone).
# Examples: 06:00 | 06:00-03 | 06:00-03:00 | 06:00 America/Recife | 06:00Z | off (disables it)
# The offset (-03) is fixed; use the zone name if your place has daylight saving time.
# BRIEFING_TIME=06:00-03

# Logs. LOG_LEVEL: console level (DEBUG, INFO, WARNING, ERROR; default INFO).
# LOG_CHANNEL_ID: Telegram channel that receives the bot's warnings (empty = disabled). Create a
# channel, add the bot as an ADMINISTRATOR with permission to post and set the ID (-100...) or
# @channelname. LOG_CHANNEL_LEVEL: minimum level sent to the channel (default WARNING; the bot's
# start and stop always go). No log carries the text of your messages or of the memory.
# LOG_LEVEL=INFO
# LOG_CHANNEL_HEADER=   (optional: text on top of each batch, for channels shared with other apps)
# LOG_CHANNEL_ID=
# LOG_CHANNEL_LEVEL=WARNING

# Language of the bot's fixed messages: detected from your first message, translated by the model and
# saved in this file (default: ./data/language.json). Delete the file to detect the language again.
# LANGUAGE_FILE=

# Web search for the chat agent: it searches only when it needs current information (news, prices, weather...).
# Uses OpenRouter's web plugin; Parallel is the cheapest engine (turbo/fast: US$ 0.001 per search, plus the
# model tokens). WEB_SEARCH=off removes the tool. WEB_SEARCH_MODEL: model of the search call (empty = OPENROUTER_MODEL).
# WEB_SEARCH=on
# WEB_SEARCH_ENGINE=parallel
# WEB_SEARCH_MODE=turbo
# WEB_SEARCH_MAX_RESULTS=3
# WEB_SEARCH_MODEL=
